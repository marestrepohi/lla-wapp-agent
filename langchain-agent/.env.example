GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FASTEMBED_CACHE_PATH=./data/fastembed
QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=replace_with_your_rotated_qdrant_key
QDRANT_MEMORY_COLLECTION=lla_customer_memories
WHATSAPP_VERIFY_TOKEN=replace_with_random_value
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
# Solo para QA local: permite vincular el WhatsApp con un ID ficticio de SQLite.
# No es una verificación de identidad. Déjalo en false fuera de QA.
WHATSAPP_QA_ID_LINKING=false
# Opcionales: por defecto Whisper transcribe en español y Qwen analiza imágenes.
# GROQ_AUDIO_MODEL=whisper-large-v3-turbo
# GROQ_AUDIO_LANGUAGE=es
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
